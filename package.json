{
  "name": "steezjam",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @steezjam/game dev",
    "site": "pnpm --filter @steezjam/game --filter @steezjam/site --parallel dev",
    "build": "pnpm --filter @steezjam/game build",
    "build:site": "pnpm --filter @steezjam/game build && pnpm --filter @steezjam/site build && node scripts/bundle-site.mjs",
    "preview": "pnpm --filter @steezjam/game preview",
    "preview:site": "pnpm build:site && pnpm --filter @steezjam/site preview",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm typecheck && pnpm build:site && pnpm test",
    "test": "playwright test",
    "test:headed": "playwright test --headed"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
